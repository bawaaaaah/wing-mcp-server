# Server
PORT=8787
MCP_AUTH_TOKEN=
MCP_CONFIG_PATH=./data/config.json
# Where the compiled dashboard lives. Leave empty unless you have moved it: the server works it out
# from its own location, which is right both in a checkout and in an installed npm package.
MCP_DASHBOARD_DIST=
# Externally-reachable base URL, used as the OAuth issuer for MCP clients that require an OAuth
# flow instead of a pasted Bearer token (most "web AI" remote connectors). Only needed once this
# server is exposed publicly (reverse proxy / tunnel) with a real HTTPS URL — defaults to
# http://localhost:<PORT> for local/LAN-only use, where a direct token is enough anyway. Persisted
# to data/config.json on first use (like MCP_AUTH_TOKEN), so it only needs to be set once.
PUBLIC_URL=

# Wing plugin (seeds data/config.json on first boot only; edit via dashboard thereafter)
WING_HOST=192.168.1.50
WING_OSC_PORT=2223
WING_DISCOVERY_PORT=2222
WING_METER_TCP_PORT=2222
# The local UDP port the console pushes meter frames to. In Docker it has to be published, and on
# a bridge network the host and container sides must be the same number.
WING_METER_UDP_PORT=14135

# Stored files
WING_PRESETS_DIR=./data/presets
WING_MIC_CALIBRATIONS_DIR=./data/mic-calibrations

# Raw OSC mirror — forwards everything the console sends to a second host (a DAW, a show-control
# system, a packet logger). Off unless enabled. Also seeds data/config.json on first boot only.
WING_OSC_MIRROR_ENABLED=false
WING_OSC_MIRROR_HOST=
WING_OSC_MIRROR_PORT=
